<Window x:Class="ScamDetector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScamShield — Live Call Analysis"
        Height="880" Width="800" MinHeight="700" MinWidth="700"
        Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- API Keys -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="AssemblyAI Key:"
                       Foreground="White" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,10,6"/>
            <PasswordBox x:Name="TxtAssemblyKey" Grid.Row="0" Grid.Column="1"
                         Padding="5" Margin="0,0,0,6"
                         Background="#2D2D30" Foreground="White" BorderBrush="#555"
                         PasswordChanged="AssemblyKey_Changed"/>
            <CheckBox x:Name="ChkSaveAssembly" Grid.Row="0" Grid.Column="2"
                      Content="Save" Foreground="#AAAAAA"
                      VerticalAlignment="Center" Margin="10,0,0,6"
                      Checked="AssemblyKey_Changed" Unchecked="AssemblyKey_Changed"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Grok (xAI) Key:"
                       Foreground="White" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <PasswordBox x:Name="TxtGrokKey" Grid.Row="1" Grid.Column="1"
                         Padding="5"
                         Background="#2D2D30" Foreground="White" BorderBrush="#555"
                         PasswordChanged="GrokKey_Changed"/>
            <CheckBox x:Name="ChkSaveGrok" Grid.Row="1" Grid.Column="2"
                      Content="Save" Foreground="#AAAAAA"
                      VerticalAlignment="Center" Margin="10,0,0,0"
                      Checked="GrokKey_Changed" Unchecked="GrokKey_Changed"/>
        </Grid>

        <!-- Buttons + auto-record toggle -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnRecord" Content="🎤 Start Recording"
                        Width="160" Height="40" Click="BtnRecord_Click"
                        Background="#28A745" Foreground="White"
                        FontWeight="Bold" Margin="0,0,10,0" Cursor="Hand"/>
                <Button x:Name="BtnStop" Content="⏹ Stop"
                        Width="160" Height="40" Click="BtnStop_Click"
                        IsEnabled="False"
                        Background="#DC3545" Foreground="White"
                        FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
            <CheckBox x:Name="ChkAutoRecord"
                      Content="Auto-record WhatsApp calls from unknown numbers"
                      IsChecked="True"
                      Foreground="#DCDCDC"
                      HorizontalAlignment="Center"
                      Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Chunk progress -->
        <Border Grid.Row="2" Background="#252526" CornerRadius="6"
                Padding="12,8" Margin="0,0,0,15">
            <TextBlock x:Name="TxtChunkStatus"
                       Text="Ready — will analyze every 30 seconds"
                       Foreground="#AAAAAA" FontSize="12"/>
        </Border>

        <!-- Scam verdict -->
        <Border x:Name="RiskBorder" Grid.Row="3"
                Background="#252526" BorderBrush="#555555" BorderThickness="2"
                CornerRadius="6" Padding="14" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock x:Name="TxtRiskLevel"
                           Text="Scam risk: not started"
                           Foreground="#AAAAAA" FontSize="18" FontWeight="Bold"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtRiskSummary"
                           Foreground="White" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <Border x:Name="ActionBox"
                        Background="#2F2F33" BorderBrush="#555555" BorderThickness="4,0,0,0"
                        CornerRadius="4" Padding="12,9" Margin="0,10,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TxtRiskAction"
                               Foreground="White" FontSize="15" FontWeight="DemiBold"
                               TextWrapping="Wrap"/>
                </Border>
                <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <TextBlock x:Name="TxtRiskReasons"
                               Foreground="#DCDCDC" TextWrapping="Wrap" FontSize="12"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Output log -->
        <GroupBox Grid.Row="4" Header="Log (chunks, Grok payloads, Grok verdicts)" Foreground="White">
            <ScrollViewer x:Name="OutputScroll" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="TxtOutput"
                         TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"
                         Background="#0D0D0D" Foreground="#00FF90"
                         FontFamily="Consolas" FontSize="12"
                         Padding="10" BorderThickness="0"/>
            </ScrollViewer>
        </GroupBox>

        <!-- Status -->
        <TextBlock x:Name="TxtStatus" Grid.Row="5"
                   Text="Status: Ready"
                   Foreground="#AAAAAA" FontStyle="Italic"
                   Margin="0,10,0,0"/>
    </Grid>
</Window>
