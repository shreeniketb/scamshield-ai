<Window x:Class="ScamDetector.KeySetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScamShield — First-Time Setup"
        Width="480" SizeToContent="Height"
        Background="#1E1E1E"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24">
        <TextBlock Text="ScamShield Setup" FontSize="20" FontWeight="Bold"
                   Foreground="White" Margin="0,0,0,6"/>
        <TextBlock Text="Enter your API keys once. They are saved to your AppData folder and never touch the project or GitHub."
                   Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,20"/>

        <TextBlock Text="AssemblyAI Key:" Foreground="White" FontWeight="Bold" Margin="0,0,0,4"/>
        <PasswordBox x:Name="TxtAssembly" Padding="6" Margin="0,0,0,14"
                     Background="#2D2D30" Foreground="White" BorderBrush="#555"/>

        <TextBlock Text="Grok (xAI) Key:" Foreground="White" FontWeight="Bold" Margin="0,0,0,4"/>
        <PasswordBox x:Name="TxtGrok" Padding="6" Margin="0,0,0,20"
                     Background="#2D2D30" Foreground="White" BorderBrush="#555"/>

        <Button x:Name="BtnSave" Content="Save and Start ScamShield"
                Height="38" Click="BtnSave_Click"
                Background="#28A745" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
        <TextBlock x:Name="TxtError" Foreground="#DC3545" TextWrapping="Wrap"
                   Margin="0,8,0,0" Visibility="Collapsed"/>
    </StackPanel>
</Window>
