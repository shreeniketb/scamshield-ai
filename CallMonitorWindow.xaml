<Window x:Class="ScamDetector.CallMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScamShield — Call Monitor"
        Width="460" SizeToContent="Height"
        Background="#1E1E1E"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        WindowStartupLocation="Manual">

    <StackPanel Margin="16">

        <!-- Recording banner -->
        <Border x:Name="RecordingBanner" Background="#3A1E22" CornerRadius="6"
                Padding="12,10" Margin="0,0,0,12">
            <DockPanel>
                <Ellipse x:Name="RecordingDot" Width="12" Height="12"
                         Fill="#DC3545" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtTimer" DockPanel.Dock="Right"
                           Text="0:00" Foreground="#DCDCDC"
                           FontFamily="Consolas" FontSize="14"
                           VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock x:Name="TxtRecordingState"
                               Text="Recording in progress"
                               Foreground="White" FontWeight="Bold" FontSize="14"/>
                    <TextBlock x:Name="TxtCaller"
                               Foreground="#BBBBBB" FontSize="12"
                               Margin="0,2,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Scam verdict (same as the main window) -->
        <Border x:Name="RiskBorder"
                Background="#252526" BorderBrush="#555555" BorderThickness="2"
                CornerRadius="6" Padding="14">
            <StackPanel>
                <TextBlock x:Name="TxtRiskLevel"
                           Text="Scam risk: listening..."
                           Foreground="#AAAAAA" FontSize="18" FontWeight="Bold"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtRiskSummary"
                           Foreground="White" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <!-- Recommended action: its own highlighted box so it stands out -->
                <Border x:Name="ActionBox"
                        Background="#2F2F33" BorderBrush="#555555" BorderThickness="4,0,0,0"
                        CornerRadius="4" Padding="12,9" Margin="0,10,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TxtRiskAction"
                               Foreground="White" FontSize="15" FontWeight="DemiBold"
                               TextWrapping="Wrap"/>
                </Border>
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <TextBlock x:Name="TxtRiskReasons"
                               Foreground="#DCDCDC" TextWrapping="Wrap" FontSize="12"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- AI Voice Detection -->
        <Border x:Name="AiVoiceBorder"
                Background="#252526" BorderBrush="#555555" BorderThickness="2"
                CornerRadius="6" Padding="12,10" Margin="0,10,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="TxtAiVoiceLabel"
                           Text="AI voice probability:"
                           Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtAiVoiceResult"
                           Foreground="#DCDCDC" FontSize="15" FontWeight="Bold"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtAiVoiceDetail"
                           Foreground="#AAAAAA" FontSize="11" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Recognize button -->
        <Button x:Name="BtnRecognize"
                Content="I recognize this number"
                Height="38" Margin="0,14,0,0"
                Background="#3A3D41" Foreground="White"
                FontWeight="Bold" Cursor="Hand"
                Click="BtnRecognize_Click"/>
        <TextBlock x:Name="TxtRecognizeNote"
                   Text="Only click this if you are 100% sure you recognize the caller. It stops recording and scam checks for this call."
                   Foreground="#999999" FontSize="11"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Margin="0,6,0,0"/>

        <!-- Shown after the call ends -->
        <Button x:Name="BtnClose"
                Content="Close"
                Height="34" Margin="0,14,0,0"
                Background="#3A3D41" Foreground="White"
                Cursor="Hand" Visibility="Collapsed"
                Click="BtnClose_Click"/>
    </StackPanel>
</Window>
