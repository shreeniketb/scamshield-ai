<Window x:Class="ScamDetector.CallMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScamShield"
        Width="460" SizeToContent="Height"
        Background="#1E1E1E"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        WindowStartupLocation="Manual"
        Closing="Window_Closing">

    <StackPanel Margin="16">

        <!-- Recording banner -->
        <Border x:Name="RecordingBanner" Background="#252526" CornerRadius="6"
                Padding="12,10" Margin="0,0,0,12">
            <DockPanel>
                <Ellipse x:Name="RecordingDot" Width="12" Height="12"
                         Fill="#555555" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtTimer" DockPanel.Dock="Right"
                           Text="" Foreground="#DCDCDC"
                           FontFamily="Consolas" FontSize="14"
                           VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock x:Name="TxtRecordingState"
                               Text="Waiting for call..."
                               Foreground="White" FontWeight="Bold" FontSize="14"/>
                    <TextBlock x:Name="TxtCaller"
                               Foreground="#BBBBBB" FontSize="12"
                               Margin="0,2,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Scam verdict -->
        <Border x:Name="RiskBorder"
                Background="#252526" BorderBrush="#555555" BorderThickness="2"
                CornerRadius="6" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="TxtRiskLevel"
                           Text="Scam risk: waiting for call..."
                           Foreground="#AAAAAA" FontSize="18" FontWeight="Bold"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtRiskSummary"
                           Foreground="White" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <Border x:Name="ActionBox"
                        Background="#2F2F33" BorderBrush="#555555" BorderThickness="4,0,0,0"
                        CornerRadius="4" Padding="12,9" Margin="0,10,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TxtRiskAction"
                               Foreground="White" FontSize="15" FontWeight="DemiBold"
                               TextWrapping="Wrap"/>
                </Border>
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <TextBlock x:Name="TxtRiskReasons"
                               Foreground="#DCDCDC" TextWrapping="Wrap" FontSize="12"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- AI Voice Detection -->
        <Border x:Name="AiVoiceBorder"
                Background="#252526" BorderBrush="#555555" BorderThickness="2"
                CornerRadius="6" Padding="12,10" Margin="0,0,0,10"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="AI voice probability:"
                           Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtAiVoiceResult"
                           Foreground="#DCDCDC" FontSize="15" FontWeight="Bold"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtAiVoiceDetail"
                           Foreground="#AAAAAA" FontSize="11" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Start / Stop button -->
        <Button x:Name="BtnAction"
                Content="▶  Start Recording"
                Height="34" Margin="0,4,0,0"
                Background="#28A745" Foreground="White"
                FontWeight="Bold" Cursor="Hand"
                Click="BtnAction_Click"/>

        <!-- Disclaimer — only visible when recording -->
        <TextBlock x:Name="TxtDisclaimer"
                   Text="Only stop the recording if you are 100% sure you recognize the caller."
                   Foreground="#999999" FontSize="11"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Margin="0,6,0,0" Visibility="Collapsed"/>

    </StackPanel>
</Window>
