<Window x:Class="ScamDetector.DashboardSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScamShield — Family dashboard"
        Width="500" SizeToContent="Height"
        Background="#1E1E1E"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24">
        <TextBlock Text="Family dashboard" FontSize="20" FontWeight="Bold"
                   Foreground="White" Margin="0,0,0,6"/>
        <TextBlock TextWrapping="Wrap" Foreground="#AAAAAA" Margin="0,0,0,16"
                   Text="Grok and the pop-up run on this computer. The family website only updates if this app sends each verdict to the URL below. Use your Vercel site if Kale and the dashboard are on different laptops. localhost only works if the web app is running on THIS computer."/>

        <CheckBox x:Name="ChkEnabled" Content="Send each Grok verdict to the family dashboard"
                  Foreground="#DCDCDC" Margin="0,0,0,14"/>

        <TextBlock Text="Dashboard URL:" Foreground="White" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtUrl" Padding="6" Margin="0,0,0,6"
                 Background="#2D2D30" Foreground="White" BorderBrush="#555"/>
        <TextBlock Text="Example: https://your-app.vercel.app   (no /family at the end)"
                   Foreground="#888888" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal">
            <Button Content="Save" Width="90" Height="34" Margin="0,0,8,0"
                    Click="BtnSave_Click"/>
            <Button Content="Test connection" Width="140" Height="34"
                    Click="BtnTest_Click"/>
        </StackPanel>
        <TextBlock x:Name="TxtStatus" Foreground="#AAAAAA" TextWrapping="Wrap"
                   Margin="0,12,0,0"/>
    </StackPanel>
</Window>
